{
  "name": "cshs-trace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CSHS TRACE - Teacher Reliever Availability and Coordination System for Educational Supervision",
  "scripts": {
    "dev": "concurrently -k -n web,worker \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "vite --config vite.config.ts",
    "dev:worker": "wrangler dev",
    "build": "vite build --config vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "db:local:apply": "wrangler d1 migrations apply trace --local",
    "db:remote:apply": "wrangler d1 migrations apply trace --remote",
    "db:local:seed": "wrangler d1 execute trace --local --file=./migrations/seed.sql",
    "db:remote:seed": "wrangler d1 execute trace --remote --file=./migrations/seed.sql",
    "gen:seed": "node scripts/gen-seed.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "hono": "^4.6.3",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.428.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20240821.0",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^4.1.11",
    "wrangler": "^3.80.0"
  }
}
